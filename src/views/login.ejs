<!DOCTYPE html>
<html lang='en'>

<head>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <title>
        <%= etiqueta %>
    </title>
    <!--Enlace entre el Head y Navigation -->
    <%- include('partials/head') %>
</head>

<body class="login">
    <!-- Barra de Navegacion -->
    <%- include('partials/navigation') %>

    <!-- Contenedor principal unificado que centra todo vertical y horizontalmente -->
    <main class="container vh-100 d-flex flex-column justify-content-center align-items-center">

        <div class="login-wrapper">

            <!-- Barra negra superior con el título -->
            <div class="login-header">
                <h1 class="h5 mb-0">Iniciar Sesión</h1>
            </div>

            <!-- Tarjeta del formulario -->
            <div class="login-card">

                <form action="/login" method="POST">
                    <% if (mensaje) { %>
                        <div class="error">
                            <%= mensaje %>
                        </div>
                    <% } %>

                    <div class="mb-3">
                        <input type="text" class="form-control" name="usuario" placeholder="Usuario" required>
                    </div>

                    <div class="mb-3">
                        <input type="password" class="form-control" name="contrasena" placeholder="Contraseña" required>
                    </div>

                <div class="d-flex justify-content-between gap-2 mb-3">
    <a href="/registro" class="btn btn-outline-light w-50 rounded-pill">Crear Usuario</a>
    <button type="submit" class="btn btn-danger w-50 rounded-pill">Ingresar</button>
</div>
<div>
    <button type="reset" class="btn btn-outline-secondary w-100 rounded-pill">Limpiar</button>
</div>
                </form>

                <!-- Enlaces de recuperación -->
                <div class="links text-center mt-3 d-flex flex-column gap-1">
                    <a href="/recuperar-password" class="text-decoration-none">Restablecer contraseña</a>
                    <a href="/recordar-usuario" class="text-decoration-none">Recordar Usuario</a>
                </div>
            </div>
        </div>

    </main>

    <%- include('partials/footer') %>
</body>

</html>