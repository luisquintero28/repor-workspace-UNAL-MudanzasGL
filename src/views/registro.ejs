<!DOCTYPE html>
<html lang='en'>

<head>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <title>
        <%= etiqueta %>
    </title>

    <%- include('partials/head') %>


</head>

<body>
    <%- include('Partials/navigation') %>

        <main class="container vh-100 d-flex flex-column justify-content-center align-items-center">

            <div class="container mt-5">
                <h1>Bienvenidos Vista de Creacion de Usuario</h1>
                <h2>Gestion de Usuario</h2>

                <!--el mensaje para la configuracion del backend-->
                        <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                        <% } %>

                <!-- FORMULARIO UNICO PARA EL DESENGLOBE DE LOS PASOS-->
                <form action="/registro" method="POST" id="formRegistro">

                    <!--======= PASO 1 ======= -->
                    <div id="paso-1" class="paso-seccion">
                        <h4>1. datos personales (Identificacion)</h4>
                        <div class="mb-3">
                            <label>Tipo de Documento</label>
                            <select name="tipoDocumento" class="form-control" id="tipoDocumento" required>
                                <option value="CEDULA">CEDULA DE CIUDADANIA</option>
                                <option value="TI">TARJETA DE IDENTIDAD</option>
                                <option value="CE">CEDULA DE EXTRANJERIA</option>
                            </select>
                        </div>
                        <label>Numero de Documento</label>
                        <input type="text" name="numeroDocumento" class="form-control" id="numeroDocumento"
                            placeholder="Digite su Cedula" required>
                            <br>

                        <button type="button" class="bnt bnt-primary" onclick="siguientePaso(2)">
                            Continuar</button>
                    </div>

                    <!--======= PASO 2 ======= -->
                    <div id="paso-2" class="paso-seccion oculto">
                        <h4>2. datos personales y Nombres</h4>
                        <p class="text-muted">Ingrese sus nombres y apellidos tal como aparecen en su documento de
                            identificacion</p>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <input type="text" name="primerNombre" class="form-control" id="primerNombre"
                                    placeholder="Digite su Primer Nombre" required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <input type="text" name="segundoNombre" class="form-control" id="segundoNombre"
                                    placeholder="Digite su Segundo Nombre" required>
                            </div>
                        </div>
                        <br>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label>Digite su Nombre Completo</label>
                                <input type="text" name="primerApellido" class="form-control" id="primerApellido"
                                    placeholder="Digite su Primer Apellido" required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <input type="text" name="segundoApellido" class="form-control" id="segundoApellido"
                                    placeholder="Digite su Segundo Apellido" required>
                            </div>
                        </div>
                        <br>
                        <div class="mb-3">
                            <label>Fecha de Nacimiento</label>
                            <input type="date" name="fechaNacimiento" class="form-control" id="fechaNacimiento"
                                required>

                        </div>

                        <button type="button" class="bnt btn-secondary" onclick="siguientePaso(1)">Atras</button>
                        <button type="button" class="bnt btn-primary" onclick="siguientePaso(3)">Continuar</button>

                    </div>

                     <!--======= PASO 3 ======= -->

                     <div id="paso-3" class="paso-seccion oculto">
                        <h4>3. Correo electronico</h4>
                        <div class="mb-3">
                              <label>Correo Electronico</label>
                            <input type="email" name="correo" class="form-control" id="correo" placeholder="correo@gmail.com"
                                required>
                        </div>
                        
                        <div class="mb-3">
                              <label>Confirmar Correo Electronico</label>
                            <input type="email" name="confirmarCorreo" class="form-control" id="confirmarCorreo" 
                            placeholder="Porfavor Confirmar correo electronico "required>
                        </div>
                         <button type="button" class="bnt btn-secondary" onclick="pasoAnterior(2)">Atras</button>
                        <button type="submit" class="bnt btn-success"> Finalizar Registro</button>

                     </div>
                </form>
            </div>
        </main>

        <%- include('Partials/footer') %>

        <!--Script de control para cambiar la vista local-->
        <script>
        function siguientePaso(pasoDestino) {
            // Validaciones rápidas opcionales por paso antes de avanzar
            if (pasoDestino === 2) {
                const doc = document.getElementById('numeroDocumento').value;
                if (!doc) {
                    alert('Por favor ingrese el número de documento');
                    return;
                }
            }

            // Ocultar todos los pasos
            document.getElementById('paso-1').classList.add('oculto');
            document.getElementById('paso-2').classList.add('oculto');
            document.getElementById('paso-3').classList.add('oculto');

            // Mostrar el paso destino
            document.getElementById('paso-' + pasoDestino).classList.remove('oculto');
        }

        function pasoAnterior(pasoDestino) {
            document.getElementById('paso-1').classList.add('oculto');
            document.getElementById('paso-2').classList.add('oculto');
            document.getElementById('paso-3').classList.add('oculto');

            document.getElementById('paso-' + pasoDestino).classList.remove('oculto');
        }
    </script>

</body>

</html>
